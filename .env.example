# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret for signing session JWTs (any long random string)

# ── Database (Supabase PostgreSQL) ─────────────────────────────
DATABASE_URL=             # PostgreSQL connection URI
# e.g. postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Admin ───────────────────────────────────────────────────────
ADMIN_PASSWORD=           # Plain-text password for the /admin page

# ── Email Notifications (Resend) ────────────────────────────────
RESEND_API_KEY=           # From resend.com dashboard → API Keys
NOTIFY_EMAIL=             # Email address to receive booking notifications
