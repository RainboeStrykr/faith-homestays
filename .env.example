# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Secret for signing session JWTs (any random string)

# ── Database (Supabase PostgreSQL) ─────────────────────────────
DATABASE_URL=             # PostgreSQL Connection URI (postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres)
# NEXT_PUBLIC_SUPABASE_URL= (optional, client-side only)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= (optional, client-side only)

# ── Auth0 ──────────────────────────────────────────────────────
AUTH0_DOMAIN=         # Auth0 tenant domain (e.g. your-tenant.us.auth0.com)
AUTH0_CLIENT_ID=      # Auth0 application Client ID
AUTH0_CLIENT_SECRET=  # Auth0 application Client Secret

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_AUTH0_DOMAIN=        # Same as AUTH0_DOMAIN (exposed to frontend)
VITE_AUTH0_CLIENT_ID=     # Same as AUTH0_CLIENT_ID (exposed to frontend)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_AUTH0_SUB=          # Auth0 sub of the admin user (e.g. google-oauth2|117234567890)